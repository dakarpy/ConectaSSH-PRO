[Unit]
Description=ConectaSSH - MODULO ONLINE WEB PRO
After=network-online.target sshpanel.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/sshpanel/online-bridge/conecta-online-bridge
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryMax=64M
CPUQuota=5%
Nice=10

[Install]
WantedBy=multi-user.target
